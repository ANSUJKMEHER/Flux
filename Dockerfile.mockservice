# Build stage
FROM golang:alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /mockservice ./cmd/mockservice/

# Runtime stage
FROM alpine:3.19

RUN apk --no-cache add ca-certificates
COPY --from=builder /mockservice /mockservice

EXPOSE 9001

ENTRYPOINT ["/mockservice"]
